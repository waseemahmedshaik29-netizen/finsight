# Default demo has no network or credential requirements.
# Local backend uses SQLite unless DATABASE_URL is set.
DATABASE_URL=sqlite:///./finsight.db
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional live integrations; never commit real keys.
FRED_API_KEY=
# Your application name and your contact email, required by SEC fair access.
SEC_USER_AGENT=
# Used by Docker Compose only; choose your own local database password.
POSTGRES_PASSWORD=finsight_local_only

# Optional model tool planner (server-side only). Pick a Responses-compatible model.
OPENAI_API_KEY=
OPENAI_MODEL=

# Market alternative when Stooq is unavailable: alphavantage (free-key compact history).
MARKET_DATA_PROVIDER=stooq
ALPHA_VANTAGE_API_KEY=
